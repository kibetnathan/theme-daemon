{
  "tools": [
    {
      "name": "bat",
      "file": "~/.config/bat/config",
      "type": "line",
      "replacements": [
        {
          "search": "--theme=\"Catppuccin Mocha\"",
          "dark": "--theme=\"Catppuccin Mocha\"",
          "light": "--theme=\"Catppuccin Latte\""
        }
      ],
      "reload": null
    },
    {
      "name": "ghostty",
      "file": "~/.config/ghostty/config",
      "type": "line",
      "replacements": [
        {
          "search": "theme = Catppuccin Mocha",
          "dark": "theme = Catppuccin Mocha",
          "light": "theme = Catppuccin Latte"
        },
        {
          "search": "background-opacity = 0.66",
          "dark": "background-opacity = 0.66",
          "light": "background-opacity = 0.85"
        }
      ],
      "reload": null
    },
    {
      "name": "btop",
      "file": "~/.config/btop/btop.conf",
      "type": "line",
      "replacements": [
        {
          "search": "color_theme = \"catppuccin-mocha\"",
          "dark": "color_theme = \"catppuccin-mocha\"",
          "light": "color_theme = \"catppuccin-latte\""
        }
      ],
      "reload": null
    },
    {
      "name": "tmux",
      "file": "~/.config/tmux/tmux.conf",
      "type": "line",
      "replacements": [
        {
          "search": "set -g @ukiyo-theme \"catppuccin/mocha\"",
          "dark": "set -g @ukiyo-theme \"catppuccin/mocha\"",
          "light": "set -g @ukiyo-theme \"catppuccin/latte\""
        }
      ],
      "reload": "tmux source-file ~/.config/tmux/tmux.conf"
    },
    {
      "name": "nvim",
      "file": "~/.config/nvim/lua/plugins/colorscheme.lua",
      "type": "line",
      "replacements": [
        {
          "search": "flavour = \"mocha\"",
          "dark": "    opts = { flavour = \"mocha\", integrations = { treesitter = true }, semantic_tokens = false },",
          "light": "    opts = { flavour = \"latte\", integrations = { treesitter = true }, semantic_tokens = false },"
        }
      ],
      "reload": null
    },
    {
      "name": "nvim-backup",
      "file": "~/.config/nvim-backup/lua/plugins/colorscheme.lua",
      "type": "line",
      "replacements": [
        {
          "search": "flavour = \"mocha\"",
          "dark": "    opts = { flavour = \"mocha\", integrations = { treesitter = true }, semantic_tokens = false },",
          "light": "    opts = { flavour = \"latte\", integrations = { treesitter = true }, semantic_tokens = false },"
        }
      ],
      "reload": null
    },
    {
      "name": "nvim-kickstart",
      "file": "~/.config/nvim-kickstart/init.lua",
      "type": "lua_ks",
      "dark_line": "  vim.cmd.colorscheme 'catppuccin'",
      "light_line": "  require('catppuccin').setup({ flavour = \"latte\" })\n  vim.cmd.colorscheme 'catppuccin'",
      "reload": null
    },
    {
      "name": "borders",
      "file": "~/.config/borders/bordersrc",
      "type": "sketchybar_color",
      "mocha_vars": {
        "BASE": "1e1e2e",
        "MANTLE": "181825",
        "TEXT": "cdd6f4",
        "SURFACE0": "313244",
        "MAUVE": "cba6f7",
        "LAVENDER": "b4befe",
        "GREEN": "a6e3a1"
      },
      "latte_vars": {
        "BASE": "eff1f5",
        "MANTLE": "e6e9ef",
        "TEXT": "4c4f69",
        "SURFACE0": "ccd0da",
        "MAUVE": "8839ef",
        "LAVENDER": "7287fd",
        "GREEN": "40a02b"
      },
      "reload": null
    },
    {
      "name": "sketchybar",
      "file": "~/.config/sketchybar/colors.sh",
      "type": "sketchybar_palette",
      "reload": "sketchybar --reload"
    },
    {
      "name": "fastfetch",
      "file": "~/.config/fastfetch/config.jsonc",
      "type": "ansi_replace",
      "reload": null
    },
    {
      "name": "newtab",
      "file": "~/.config/newtab/newtab.html",
      "type": "line",
      "replacements": [
        {
          "search": "background: #0d0d0d",
          "dark": "        background: #0d0d0d;",
          "light": "        background: #eff1f5;"
        }
      ],
      "reload": null
    },
    {
      "name": "darktable",
      "file": "~/.config/darktable/darktablerc-common",
      "type": "line",
      "replacements": [
        {
          "search": "ui_last/theme=darktable-elegant-grey",
          "dark": "ui_last/theme=darktable-elegant-grey",
          "light": "ui_last/theme=darktable-elegant-light"
        }
      ],
      "reload": null
    },
    {
      "name": "yabai",
      "file": "~/.config/yabai/yabairc",
      "type": "line",
      "replacements": [
        {
          "search": "insert_feedback_color 0xffa6e3a1",
          "dark": "  insert_feedback_color 0xffa6e3a1 \\",
          "light": "  insert_feedback_color 0xff40a02b \\"
        }
      ],
      "reload": "yabai --restart-service"
    }
  ]
}
